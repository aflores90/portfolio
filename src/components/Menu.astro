---
import {
  getLangFromUrl,
  useTranslations,
  useTranslatedPath,
} from '../i18n/utils'

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)
const translatePath = useTranslatedPath(lang)
---

<nav class="lg:flex md:flex flex-row gap-x-7 opacity-90 hidden sm:flex">
  <a href={translatePath('/#home')}>{t('nav.home')}</a>
  <a href={translatePath('/#about')}>{t('nav.about')}</a>
  <a href={translatePath('/#experience')}>{t('nav.experience')}</a>
  <a href={translatePath('/#projects')}>{t('nav.projects')}</a>
  <a href={translatePath('/#contact')}>{t('nav.contact')}</a>
  <a href={translatePath('/blog')}>{t('nav.blog')}</a>
</nav>
