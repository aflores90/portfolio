---
import { languages } from '@/i18n/ui'
import { getLangFromUrl, useTranslatedPath } from '@/i18n/utils'

const defaultLang = getLangFromUrl(Astro.url)
const translatePath = useTranslatedPath(defaultLang)
---

<ul class="flex space-x-4 bg-gray-100 py-2 px-4 rounded-lg shadow-lg">
  {
    Object.entries(languages).map(([lang, label]) => (
      <li class="relative group">
        <a
          href={translatePath('/', lang)}
          class={`${defaultLang == lang ? 'text-blue-500' : 'text-gray-600'} hover:text-blue-500 font-semibold transition-colors duration-200`}
        >
          {label}
        </a>
        <span class="absolute bottom-0 left-0 w-0 h-0.5 bg-blue-500 group-hover:w-full transition-all duration-200" />
      </li>
    ))
  }
</ul>
