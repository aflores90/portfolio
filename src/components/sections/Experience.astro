---
import ExperienceItem from '@/components/ExperienceItem.astro'
import type { Experience } from '@/types/experience'
import AwardIcon from '@/icons/Award.astro'

const EXPERIENCE: Experience[] = [
  {
    date: 'Actualmente...',
    title: 'Senior Software Engineer',
    company: 'Payjoy Inc',
    description:
      'Lidero el diseño, desarrollo y optimización de soluciones de software, asegurando la calidad y escalabilidad de los proyectos, mientras colaboro estrechamente con el equipo para alcanzar los objetivos de negocio.',
    goals: [
      'Implementar mejoras en la arquitectura del sistema.',
      'Optimizar el rendimiento de aplicaciones críticas.',
      'Guiar al equipo en la adopción de mejores prácticas de desarrollo.',
    ],
    link: 'https://www.payjoy.com/',
  },
  {
    date: 'Julio 2022 - Diciembre 2022',
    title: 'Full Stack Engineer',
    company: 'Lean Tech',
    description:
      'Diseñé e implementé soluciones completas (frontend y backend) para proyectos clave, alineándome con los estándares de calidad y las expectativas del cliente.',
    goals: [
      'Desarrollar aplicaciones web de alto impacto.',
      'Asegurar la integración fluida entre frontend y backend.',
      'Colaborar con equipos multidisciplinarios para cumplir objetivos del cliente.',
    ],
    link: 'https://www.leangroup.com/solutions-and-services/technology/software-development-staffing',
  },
  {
    date: 'Septiembre 2021 - Junio 2022',
    title: 'Analista Desarrollador',
    company: 'Refugio de la Niñez',
    description:
      'Desarrollé sistemas internos para apoyar los procesos administrativos y operativos, contribuyendo al impacto social de la organización.',
    goals: [
      'Automatizar procesos clave mediante software personalizado.',
      'Mejorar la eficiencia de las herramientas internas.',
      'Colaborar con áreas no técnicas para entender y solucionar sus necesidades.',
    ],
    link: 'https://refugiodelaninez.org/',
  },
  {
    date: 'Marzo 2020 - Julio 2021',
    title: 'Software Developer',
    company: 'Business Development Group, S.A.',
    description:
      'Participé en el desarrollo y mantenimiento de plataformas empresariales, asegurando su estabilidad y escalabilidad.',
    goals: [
      'Optimizar bases de datos para mejorar tiempos de respuesta.',
      'Implementar funcionalidades que aumenten el valor de negocio.',
      'Asegurar la calidad del código mediante pruebas automatizadas.',
    ],
    link: 'https://bdgsa.net/',
  },
  {
    date: 'Julio 2018 - Marzo 2020',
    title: 'Analista Programador',
    company: 'Ministerio de Gobernación',
    description:
      'Colaboré en proyectos tecnológicos críticos para la gestión y análisis de información gubernamental.',
    goals: [
      'Desarrollar herramientas para la gestión de datos.',
      'Asegurar la integridad y seguridad de los sistemas.',
      'Capacitar a usuarios en el uso de las nuevas plataformas.',
    ],
    link: 'https://mingob.gob.gt/',
  },
  {
    date: 'Diciembre 2013 - Mayo 2018',
    title: 'Analista Programador',
    company: 'Homeland Cloud Software',
    description:
      'Diseñé, implementé y mantuve sistemas empresariales en la nube para clientes en diversas industrias.',
    goals: [
      'Migrar sistemas legacy a soluciones basadas en la nube.',
      'Crear documentación técnica detallada para futuros desarrollos.',
      'Asegurar la continuidad operativa mediante soporte técnico avanzado.',
    ],
    link: 'https://www.homeland.com.gt/',
  },
]
---

<h2 class="text-2xl mb-6 font-semibold flex gap-x-3 items-center">
  <AwardIcon class="size-7" />Experiencia Laboral
</h2>
<ol class="relative border-s border-gray-200 dark:border-gray-700 ml-3">
  {
    EXPERIENCE.map((experience: Experience) => (
      <li class="mb-10 ms-4">
        <ExperienceItem experience={experience} />
      </li>
    ))
  }
</ol>
